{
  "name": "nextjs",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "bun run db:generate",
    "build": "next build --turbopack",
    "check-types": "tsc --noEmit",
    "dev": "next dev --turbopack",
    "start": "next start",
    "doctor": "bunx react-doctor@latest",
    "db:generate": "bun --bun prisma generate",
    "db:migrate": "bun --bun prisma migrate dev",
    "db:deploy": "bun --bun prisma migrate deploy",
    "db:push": "bun --bun prisma db push",
    "db:pull": "bun --bun prisma db pull",
    "db:reset": "bun --bun prisma migrate reset",
    "db:seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/client-secrets-manager": "^3.1123.0",
    "@base-ui/react": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@t3-oss/env-core": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ky": "^2.1.0",
    "lucide-react": "^1.38.0",
    "neverthrow": "^8.2.0",
    "next": "15.5.24",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/ws": "^8.18.1",
    "babel-plugin-react-compiler": "1.0.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
